# ---- Server ----
PORT=4500
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/ai_content_factory

# ---- AI provider (server-side only, never expose to the browser) ----
# Leave AI_API_KEY empty to run with the built-in mock AI provider (no network, no cost).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=16000

# ---- Local file storage (V1: no S3) ----
GENERATED_ROOT=./generated

# ---- Discovery sources ----
DISCOVERY_RSS_FEEDS=https://openai.com/blog/rss.xml,https://engineering.fb.com/feed/,https://netflixtechblog.com/feed,https://github.blog/engineering.atom
DISCOVERY_GITHUB_REPOS=anthropics/claude-code,modelcontextprotocol/servers,facebook/react,langchain-ai/langchain,vercel/next.js
DISCOVERY_MAX_CANDIDATES=20

# Optional: raises GitHub API rate limits for discovery. Not required.
GITHUB_TOKEN=
