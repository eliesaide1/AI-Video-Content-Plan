# ---- Server ----
PORT=4500
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/ai_content_factory

# ---- AI provider (server-side only, never expose to the browser) ----
# AI_PROVIDER options:
#   claude-cli  use the local Claude Code CLI, i.e. your Claude subscription.
#               No API key and no per-token billing; needs `claude` installed
#               and logged in on this machine. Local development only.
#   anthropic   use the Anthropic API. Needs AI_API_KEY with credits. Required
#               for anything deployed to a server.
#   mock        offline placeholders, for testing the plumbing only.
AI_PROVIDER=claude-cli
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=16000

# claude-cli only: model alias ('sonnet', 'opus') or full name, and the time
# one generation is allowed to take.
AI_CLI_BINARY=claude
AI_CLI_TIMEOUT_MS=300000

# ---- Local file storage (V1: no S3) ----
GENERATED_ROOT=./generated

# ---- Discovery sources ----
# Discovery reads SIGNALS from these, then the AI proposes buildable course
# ideas from them. A source item is evidence, never the topic itself.

# "How we built X" engineering writing — the most useful signal for teaching.
DISCOVERY_RSS_FEEDS=https://openai.com/blog/rss.xml,https://engineering.fb.com/feed/,https://netflixtechblog.com/feed,https://github.blog/engineering.atom,https://stackoverflow.blog/feed/

# Subjects used to find trending repos and community tutorials.
DISCOVERY_TRENDING_TOPICS=ai-agents,llm,typescript,react,devops

# Minimum Hacker News score for a story to count as a signal.
DISCOVERY_HN_MIN_POINTS=150

# Optional: watch specific repos for MAJOR releases (canary/alpha/patch notes
# are filtered out). Leave empty to skip release feeds entirely.
DISCOVERY_GITHUB_REPOS=

DISCOVERY_MAX_CANDIDATES=20

# Optional: raises GitHub API rate limits for discovery. Not required.
GITHUB_TOKEN=
